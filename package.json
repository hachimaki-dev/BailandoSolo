{
  "name": "Bailando Solo",
  "version": "1.0.0",
  "description": "Descargador de Playlists de Alta Fidelidad",
  "main": "main.js",
  "scripts": {
    "start": "npm --prefix ui run build && electron .",
    "dev": "concurrently \"npm --prefix ui run dev\" \"wait-on tcp:5173 && electron . --dev\"",
    "build": "npm --prefix ui run build",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.bailandosolo.app",
    "productName": "Bailando Solo",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json",
      "ui/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": ".",
        "filter": ["bailandosolo-server", "bailandosolo-server.exe"]
      }
    ],
    "linux": {
      "target": ["AppImage", "deb"]
    },
    "win": {
      "target": ["nsis"]
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "wait-on": "^9.0.3"
  }
}
